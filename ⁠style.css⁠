/* Global Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Kanit', sans-serif;
}

body {
  background-color: #121831;
  color: #ffffff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

a {
  text-decoration: none;
  color: inherit;
}

/* Navbar */
header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8%;
  background: rgba(18, 24, 49, 0.95);
  backdrop-filter: blur(10px);
  z-index: 1000;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 1px;
}

.logo-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff416c, #ff4b2b, #ff8c00);
  border: 3px solid #ff416c;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 30px;
  align-items: center;
}

.nav-links a {
  font-size: 0.9rem;
  font-weight: 400;
  color: #a0a7c2;
  transition: color 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.nav-links a:hover,
.nav-links a.active {
  color: #ffffff;
}

.btn-get-started {
  background: linear-gradient(135deg, #ff416c, #ff4b2b, #ff8c00);
  color: #fff !important;
  padding: 8px 22px;
  border-radius: 20px;
  font-weight: 600 !important;
  transition: transform 0.3s ease, box-shadow 0.3s ease !important;
}

.btn-get-started:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(255, 65, 108, 0.4);
}

/* Main Container */
main {
  flex: 1;
  padding: 130px 8% 60px 8%;
  display: flex;
  align-items: center;
}

/* Common Components */
.underline-accent {
  width: 60px;
  height: 3px;
  background: linear-gradient(90deg, #ff416c, #ff8c00);
  margin: 15px 0 25px 0;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 700;
}

.section-container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Home Section Layout */
.home-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.hero-text {
  max-width: 500px;
}

.hero-text h1 {
  font-size: 3.5rem;
  line-height: 1.1;
  font-weight: 700;
  text-transform: uppercase;
}

.hero-text p {
  color: #94a3b8;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 30px;
}

.btn-read-more {
  display: inline-block;
  background: linear-gradient(135deg, #ff416c, #ff4b2b, #ff8c00);
  color: #fff;
  padding: 10px 28px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 15px rgba(255, 65, 108, 0.3);
  transition: all 0.3s ease;
}

.btn-read-more:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(255, 65, 108, 0.5);
}

.hero-graphic {
  position: relative;
  width: 420px;
  height: 420px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.main-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff2a55 0%, #ff523b 40%, #ff7a18 100%);
  box-shadow: 0 10px 40px rgba(255, 65, 108, 0.2);
}

.circle-ring {
  position: absolute;
  width: 108%;
  height: 108%;
  border-radius: 50%;
  border: 2px dashed rgba(255, 120, 50, 0.5);
  animation: rotateRing 30s linear infinite;
}

@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* About Section */
.about-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.about-card {
  background: #1a223f;
  padding: 30px;
  border-radius: 15px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.about-card h3 {
  font-size: 1.5rem;
  margin-bottom: 15px;
  color: #ff523b;
}

.about-card p {
  color: #94a3b8;
  line-height: 1.7;
  margin-bottom: 15px;
}

.icon-check {
  color: #ff523b;
  margin-right: 8px;
}

/* Portfolio Section */
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
}

.portfolio-item {
  background: #1a223f;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: transform 0.3s ease;
}

.portfolio-item:hover {
  transform: translateY(-8px);
}

.portfolio-img {
  height: 180px;
  background: linear-gradient(135deg, #2a3459, #1a223f);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  color: #ff523b;
}

.portfolio-info {
  padding: 20px;
}

.portfolio-info h4 {
  font-size: 1.2rem;
  margin-bottom: 10px;
}

.portfolio-info p {
  color: #94a3b8;
  font-size: 0.85rem;
}

/* Contact Section */
.contact-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 12px 15px;
  margin-bottom: 20px;
  background: #1a223f;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: #fff;
  font-size: 0.9rem;
}

.contact-form textarea {
  height: 120px;
  resize: none;
}

.contact-form button {
  background: linear-gradient(135deg, #ff416c, #ff4b2b, #ff8c00);
  color: #fff;
  border: none;
  padding: 12px 30px;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 15px;
  background: #1a223f;
  padding: 20px;
  border-radius: 10px;
}

.contact-card i {
  font-size: 1.5rem;
  color: #ff523b;
}

.text-sub {
  color: #94a3b8;
}

/* Responsive */
@media (max-width: 900px) {
  .home-container {
    flex-direction: column;
    text-align: center;
    gap: 40px;
  }

  .underline-accent {
    margin: 15px auto 25px auto;
  }

  .hero-graphic {
    width: 260px;
    height: 260px;
  }

  .about-content,
  .contact-wrapper {
    grid-template-columns: 1fr;
  }

  .nav-links {
    display: none;
  }
}
